{
  "name": "fdsh-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Local development tools and specifications for FDSH integrations.",
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "lint": "pnpm run lint:disclaimer && pnpm run lint:markdown && pnpm run lint:specs && pnpm run spellcheck",
    "lint:disclaimer": "node scripts/check-readme-disclaimers.mjs",
    "lint:markdown": "markdownlint-cli2",
    "lint:markdown:fix": "pnpm run lint:markdown --fix",
    "lint:specs": "pnpm --filter @fdsh-utils/spec-medh-nsc lint",
    "fmt:prettier": "prettier --check .",
    "fmt:prettier:fix": "prettier --write .",
    "spellcheck": "cspell --config cspell.config.yaml .",
    "test": "pnpm run lint"
  },
  "devDependencies": {
    "@github/markdownlint-github": "^0.8.3",
    "cspell": "^9.2.1",
    "markdown-it": "^15.0.0",
    "markdownlint-cli2": "^0.23.2",
    "markdownlint-cli2-formatter-pretty": "^0.0.10",
    "prettier": "^3.9.6"
  }
}
